{
  "name": "sebeverify-sdk",
  "version": "0.1.2",
  "description": "SebeVerify SDK - Server-side identity verification library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist --skipLibCheck",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.7.3"
  }
}
