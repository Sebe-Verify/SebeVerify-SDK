{
    "name": "sebeverify-sdk",
    "version": "0.1.4",
    "description": "SebeVerify SDK - Server-side identity verification library",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup && tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist --skipLibCheck",
        "dev": "tsup --watch"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsup": "^8.5.1",
        "typescript": "5.7.3"
    }
}
